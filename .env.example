# Neon serverless Postgres (usa la cadena "pooled" que entrega Neon)
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar la cookie de sesion (min 32 caracteres)
# Genera uno con: openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Descomenta esta linea SOLO en desarrollo local si ves el error
# "SELF_SIGNED_CERT_IN_CHAIN": significa que un antivirus o proxy
# corporativo esta interceptando el trafico HTTPS de tu maquina.
# Fuerza el driver node-postgres, que evita ese problema.
# DB_DRIVER=pg
